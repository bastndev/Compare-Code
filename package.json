{
  "name": "compare-code",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.3",
  "publisher": "bastndev",
  "preview": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other","Visualization"],
  "keywords": [
    "compare",
    "code",
    "diff",
    "Draw",
    "match",
    "vscode",
    "extension",
    "productivity",
    "2025",
    "cc"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "homepage": "https://github.com/bastndev/Compare-Code#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bastndev/Compare-Code"
  },
  "bugs": {
    "url": "https://github.com/bastndev/Compare-Code/issues"
  },
  "author": {
    "name": "Gohit Bastian",
    "email": "gobasdev@gmail.com",
    "url": "https://www.bastndev.com"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/bastndev"
  },

  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "compare-code.compareFiles",
        "title": "%command.compareCode.title%",
        "icon": "$(activate-breakpoints)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "compare-code.compareFiles",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "compare-code.compareFiles",
        "key": "alt+shift+\\",
        "mac": "alt+shift+\\"
      }
    ]
  },

  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run build-scss && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run build-scss && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",

    "compile-scss": "sass src/ui/webview/styles/main.scss:src/ui/webview/styles/main.css",
    "build-scss": "sass src/ui/webview/styles/main.scss:src/ui/webview/styles/main.css",
    "watch:scss": "sass src/ui/webview/styles/main.scss:src/ui/webview/styles/main.css --watch",
    "prebuild": "npm run build-scss"
  },

  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.92.1",
    "typescript": "^5.7.3"
  }
}
