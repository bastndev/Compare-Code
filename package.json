{
  "name": "compare-code",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.9",
  "publisher": "bastndev",
  "preview": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other","Visualization"],
  "keywords": [
    "compare",
    "code",
    "diff",
    "Draw",
    "match",
    "vscode",
    "extension",
    "productivity",
    "cc"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "homepage": "https://github.com/bastndev/Compare-Code#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bastndev/Compare-Code"
  },
  "bugs": {
    "url": "https://github.com/bastndev/Compare-Code/issues"
  },
  "author": {
    "name": "Gohit Bastian", 
    "email": "hello@gohit.xyz",
    "url": "https://www.gohit.xyz/me"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/bastndev"
  },

  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",

  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.92.1",
    "typescript": "^5.7.3"
  }
}
